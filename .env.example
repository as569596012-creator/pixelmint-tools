# ============================================================================
# 复制本文件为 .env(不要提交 .env 到仓库),按下面说明填入你的真实信息。
#   PowerShell:  Copy-Item .env.example .env
# 带 NEXT_PUBLIC_ 前缀的变量会在「构建时」打包进静态页面(浏览器可见);
# 其余(GIT_/SERVER_/CLOUDFLARE_)只用于部署脚本,不会进入前端代码。
# ============================================================================

# ===== 站点基本信息(构建时注入,影响 canonical / sitemap / OG)=====
# 你的正式域名,上线前必须改成真实域名(末尾不要带斜杠)
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=PixelMint
NEXT_PUBLIC_SITE_TAGLINE=Free in-browser image tools — compress and convert without uploading.
NEXT_PUBLIC_SITE_DESCRIPTION=Free online image tools that run 100% in your browser. Compress images, convert HEIC to JPG, PNG to JPG, and images to WebP. No uploads, no sign-up, no watermark.

# E-E-A-T:真实作者署名(Google 排名与 AdSense 审核都看重)
NEXT_PUBLIC_AUTHOR_NAME=Your Name
NEXT_PUBLIC_AUTHOR_PROFILE_URL=   # 例: 你的 LinkedIn 个人主页,留空则不显示
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# ===== 变现(站点有内容后再申请;通过审核拿到 ID 后填这里就会自动启用广告)=====
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=   # 例: ca-pub-1234567890123456,留空则显示占位广告框
NEXT_PUBLIC_EZOIC_SITE_ID=          # 若用 Ezoic 变现

# ===== 分析(二选一或都填;留空则不加载任何分析脚本)=====
NEXT_PUBLIC_GA4_ID=                 # 例: G-XXXXXXXXXX(Google Analytics 4)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=       # 例: example.com(Plausible,更注重隐私)

# ===== 站长验证(可选,用 meta 验证时可参考)=====
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
BING_WEBMASTER_VERIFICATION=

# ============================================================================
# 以下仅用于「部署」,不会进入前端代码
# ============================================================================

# ===== 代码仓库 =====
GIT_REPOSITORY_URL=                 # 例: git@github.com:you/pixelmint.git
GIT_BRANCH=main

# ===== 方案 A:Cloudflare Pages 部署(推荐,免费 + 全球 CDN)=====
# 在 Cloudflare 仪表盘 -> My Profile -> API Tokens 创建带 Pages 编辑权限的 Token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=pixelmint   # Cloudflare Pages 里的项目名

# ===== 方案 B:自有服务器部署(Docker + Nginx 托管 out/ 静态产物)=====
SERVER_HOST=                        # 服务器公网 IP 或域名
SERVER_USER=                        # SSH 登录名,例: root
SERVER_PASSWORD=                    # SSH 密码(或改用密钥)
SERVER_SSH_PORT=22
SERVER_DEPLOY_PATH=/var/www/pixelmint

# ===== 后续做「AI 类工具」时才需要(本批工具刻意不用,保持零成本)=====
OPENAI_API_KEY=
